# =============================================
# B2Bmax MVP1 - Configuration
# =============================================

# Copier ce fichier en .env et compléter avec vos informations
# cp .env.example .env

# -------------------------------------------
# Supabase Configuration
# -------------------------------------------
# URL de votre projet Supabase
# Trouvable dans: https://app.supabase.com/project/votre-projet/settings/api
SUPABASE_URL=https://votre-projet.supabase.co

# Clé de service (Service Key) - À utiliser pour le chargement des données
# Trouvable dans: https://app.supabase.com/project/votre-projet/settings/api
# ⚠️ NE PAS UTILISER la clé anonyme (anon key) pour ce script
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé anonyme (Anon Key) - Pour les requêtes depuis le frontend
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------
# Mistral AI Configuration (optionnel pour MVP1)
# -------------------------------------------
# Clé API Mistral pour le NLP
# Trouvable dans: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key

# Modèle à utiliser (par défaut: mistral-small)
MISTRAL_MODEL=mistral-small

# -------------------------------------------
# Application Configuration
# -------------------------------------------
# URL du backend (pour le frontend)
BACKEND_URL=http://localhost:8000

# Port du backend FastAPI
BACKEND_PORT=8000

# Environnement (development, staging, production)
ENVIRONMENT=development

# Mode debug
DEBUG=true

# -------------------------------------------
# Chemins des fichiers de données
# -------------------------------------------
# Dossier des données (relatif à la racine du projet)
DATA_DIR=./data

# Fichiers CSV (optionnel - peut être modifié)
UNITE_LEGALE_CSV=StockUniteLegale_extract_10000.csv
ETABLISSEMENT_CSV=StockEtablissement_extract_10000.csv
