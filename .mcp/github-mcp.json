{
  "name": "github-market-repo",
  "version": "1.0.0",
  "description": "GitHub MCP server for market signals project management",
  "type": "typescript",
  "entrypoint": "dist/index.js",
  "runtime": "node",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@octokit/rest": "^20.0.0"
  },
  "capabilities": [
    {
      "type": "read",
      "resource": "repository",
      "description": "Read project files, skills documentation"
    },
    {
      "type": "write",
      "resource": "repository", 
      "description": "Commit changes, create branches, manage PRs"
    },
    {
      "type": "function",
      "name": "create_issue",
      "description": "Track bugs and feature requests"
    },
    {
      "type": "function",
      "name": "search_code",
      "description": "Find code in the repository"
    }
  ]
}
