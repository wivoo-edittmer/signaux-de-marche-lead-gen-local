# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Mistral AI Configuration (pour la transcription audio Voxtral)
MISTRAL_API_KEY=your-mistral-api-key

# CORS - Origines autorisées (séparées par des virgules)
# En plus des origines localhost par défaut, ajouter les domaines de production
# ALLOWED_ORIGINS=https://b2bmax.vercel.app,https://b2bmax-front.vercel.app

# Optional: Direct PostgreSQL connection (not used in Next.js API routes)
# SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.your-project
# SUPABASE_DB_PASSWORD=your-password
